{
  "manifest_version": 2,
  "name": "Gmail Blur Privacy",
  "version": "1.0.0",
  "description": "Blurs Gmail subjects, senders, snippets and bodies. Hover/click to reveal. Toggle via toolbar.",
  "permissions": ["storage", "*://mail.google.com/*", "*://gmail.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*", "*://gmail.com/*"],
      "js": ["content.js"],
      "css": ["blur.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "Gmail Blur Privacy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gmail-blur-privacy@example.com",
      "strict_min_version": "57.0"
    }
  }
}
